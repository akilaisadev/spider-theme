{
  "name": "Noir Detective",
  "type": "hc-black",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#D4A5FFF2",
    "class.declaration": {
      "foreground": "#D4A5FFF2",
      "fontStyle": "bold"
    },
    "type": "#D4A5FFF2",
    "interface": {
      "foreground": "#D4A5FFF2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#80C7FF",
    "method": "#80C7FF",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#FFFFE0E6",
    "property": "#FFFFE0D9",
    "keyword": "#FF8C9AB3",
    "string": "#A3D98A",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#5C6370",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#80C7FF40",
    "foreground": "#FFFFE0E6",
    "widget.shadow": "#00000080",
    "editor.background": "#000000",
    "editor.foreground": "#FFFFE0",
    "editor.lineHighlightBackground": "#111111",
    "editor.selectionBackground": "#333333",
    "editor.inactiveSelectionBackground": "#33333380",
    "editor.selectionHighlightBackground": "#333333A0",
    "editor.wordHighlightBackground": "#333333A0",
    "editor.wordHighlightStrongBackground": "#80C7FF30",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#80C7FF",
    "editorWhitespace.foreground": "#5C637040",
    "editorIndentGuide.background": "#5C637020",
    "editorIndentGuide.activeBackground": "#5C637060",
    "editorBracketMatch.background": "#80C7FF30",
    "editorBracketMatch.border": "#80C7FF80",
    "editorLineNumber.foreground": "#5C637073",
    "editorLineNumber.activeForeground": "#FFFFE0E6",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#5C637040",
    "sideBar.background": "#000000",
    "sideBar.foreground": "#FFFFE0D9",
    "sideBar.border": "#000000",
    "sideBarSectionHeader.background": "#000000",
    "activityBar.background": "#000000",
    "activityBar.foreground": "#80C7FF",
    "activityBar.inactiveForeground": "#5C637073",
    "activityBar.border": "#000000",
    "statusBar.background": "#000000",
    "statusBar.foreground": "#FFFFE0D9",
    "statusBar.border": "#000000",
    "statusBar.noFolderBackground": "#000000",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#000000",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#000000",
    "panel.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#FFFFE0",
    "terminal.ansiBlack": "#000000",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#80C7FF",
    "terminal.ansiMagenta": "#D4A5FF",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#FFFFE0",
    "terminal.ansiBrightBlack": "#5C6370",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#80C7FF",
    "terminal.ansiBrightMagenta": "#D4A5FF",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#80C7FF",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#D4A5FF",
    "gitDecoration.ignoredResourceForeground": "#5C637073"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C6370",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BF4D"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FF8C9AB3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#80C7FF"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#D4A5FFF2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FFFFE0E6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#A3D98A"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#80C7FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#D4A5FFD9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#FF8C9AB3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}