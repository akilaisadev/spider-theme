{
  "name": "Emerald Menace",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#4361EEF2",
    "class.declaration": {
      "foreground": "#4361EEF2",
      "fontStyle": "bold"
    },
    "type": "#4361EEF2",
    "interface": {
      "foreground": "#4361EEF2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#7209B7",
    "method": "#7209B7",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#F8F9FAE6",
    "property": "#F8F9FAD9",
    "keyword": "#38B000B3",
    "string": "#F48C06",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#5C677D",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#7209B740",
    "foreground": "#F8F9FAE6",
    "widget.shadow": "#00000080",
    "editor.background": "#2C313C",
    "editor.foreground": "#F8F9FA",
    "editor.lineHighlightBackground": "#363C49",
    "editor.selectionBackground": "#404859",
    "editor.inactiveSelectionBackground": "#40485980",
    "editor.selectionHighlightBackground": "#404859A0",
    "editor.wordHighlightBackground": "#404859A0",
    "editor.wordHighlightStrongBackground": "#7209B730",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#7209B7",
    "editorWhitespace.foreground": "#5C677D60",
    "editorIndentGuide.background": "#5C677D40",
    "editorIndentGuide.activeBackground": "#5C677D90",
    "editorBracketMatch.background": "#7209B740",
    "editorBracketMatch.border": "#7209B7A0",
    "editorLineNumber.foreground": "#5C677D90",
    "editorLineNumber.activeForeground": "#F8F9FA",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#5C677D40",
    "sideBar.background": "#252932",
    "sideBar.foreground": "#F8F9FAD9",
    "sideBar.border": "#252932",
    "sideBarSectionHeader.background": "#252932",
    "activityBar.background": "#20232A",
    "activityBar.foreground": "#7209B7",
    "activityBar.inactiveForeground": "#5C677D73",
    "activityBar.border": "#20232A",
    "statusBar.background": "#1B1E24",
    "statusBar.foreground": "#F8F9FAD9",
    "statusBar.border": "#1B1E24",
    "statusBar.noFolderBackground": "#1B1E24",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#252932",
    "tab.activeBackground": "#2C313C",
    "tab.inactiveBackground": "#252932",
    "panel.background": "#2C313C",
    "terminal.background": "#2C313C",
    "terminal.foreground": "#F8F9FA",
    "terminal.ansiBlack": "#20232A",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#7209B7",
    "terminal.ansiMagenta": "#4361EE",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#F8F9FA",
    "terminal.ansiBrightBlack": "#5C677D",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#7209B7",
    "terminal.ansiBrightMagenta": "#4361EE",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#7209B7",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#4361EE",
    "gitDecoration.ignoredResourceForeground": "#5C677D73"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5C677D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#38B000B3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7209B7"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#4361EEF2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#F8F9FAE6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#F48C06"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#7209B7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#4361EED9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#38B000B3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}