{
  "name": "Emerald Menace",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#7088FF",
    "class.declaration": {
      "foreground": "#7088FF",
      "fontStyle": "bold"
    },
    "struct": "#7088FF",
    "enum": "#E5C07B",
    "enumMember": "#D19A66",
    "type": "#7088FF",
    "type.declaration": {
      "foreground": "#7088FF",
      "fontStyle": "bold"
    },
    "type.defaultLibrary": "#56B6C2",
    "typeParameter": {
      "foreground": "#7088FF",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#7088FF",
      "fontStyle": "italic"
    },
    "function": "#38D9A9",
    "function.declaration": {
      "foreground": "#38D9A9",
      "fontStyle": "bold"
    },
    "function.defaultLibrary": "#38D9A9",
    "method": "#38D9A9",
    "method.declaration": {
      "foreground": "#38D9A9",
      "fontStyle": "bold"
    },
    "macro": {
      "foreground": "#38D9A9",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#56B6C2",
      "fontStyle": "italic"
    },
    "selfParameter": {
      "foreground": "#52B788",
      "fontStyle": "italic"
    },
    "clsParameter": {
      "foreground": "#52B788",
      "fontStyle": "italic"
    },
    "variable": "#F8F9FA",
    "variable.readonly": {
      "foreground": "#E5C07B",
      "fontStyle": "bold"
    },
    "variable.defaultLibrary": "#56B6C2",
    "property": "#F8F9FA",
    "property.readonly": "#E5C07B",
    "keyword": "#52B788",
    "keyword.control": {
      "foreground": "#52B788",
      "fontStyle": "bold"
    },
    "string": "#F48C06",
    "string.escape": {
      "foreground": "#52B788",
      "fontStyle": "bold"
    },
    "number": "#D19A66",
    "operator": "#ABB2BFD9",
    "comment": {
      "foreground": "#9AA5B9",
      "fontStyle": "italic"
    },
    "decorator": {
      "foreground": "#C678DD",
      "fontStyle": "italic"
    },
    "namespace": "#56B6C2",
    "*.mutable": {
      "fontStyle": "underline"
    }
  },
  "colors": {
    "focusBorder": "#38D9A940",
    "foreground": "#F8F9FA",
    "widget.shadow": "#00000080",
    "editor.background": "#2C313C",
    "editor.foreground": "#F8F9FA",
    "editor.lineHighlightBackground": "#363C49",
    "editor.selectionBackground": "#404859",
    "editor.inactiveSelectionBackground": "#40485980",
    "editor.selectionHighlightBackground": "#404859A0",
    "editor.wordHighlightBackground": "#404859A0",
    "editor.wordHighlightStrongBackground": "#38D9A930",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#38D9A9",
    "editorWhitespace.foreground": "#9AA5B960",
    "editorIndentGuide.background": "#9AA5B940",
    "editorIndentGuide.activeBackground": "#9AA5B990",
    "editorBracketMatch.background": "#38D9A940",
    "editorBracketMatch.border": "#38D9A9A0",
    "editorLineNumber.foreground": "#9AA5B990",
    "editorLineNumber.activeForeground": "#F8F9FA",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#9AA5B940",
    "sideBar.background": "#252932",
    "sideBar.foreground": "#F8F9FA",
    "sideBar.border": "#252932",
    "sideBarSectionHeader.background": "#252932",
    "activityBar.background": "#20232A",
    "activityBar.foreground": "#38D9A9",
    "activityBar.inactiveForeground": "#9AA5B973",
    "activityBar.border": "#20232A",
    "statusBar.background": "#1B1E24",
    "statusBar.foreground": "#F8F9FA",
    "statusBar.border": "#1B1E24",
    "statusBar.noFolderBackground": "#1B1E24",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#252932",
    "tab.activeBackground": "#2C313C",
    "tab.inactiveBackground": "#252932",
    "panel.background": "#2C313C",
    "terminal.background": "#2C313C",
    "terminal.foreground": "#F8F9FA",
    "terminal.ansiBlack": "#20232A",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#38D9A9",
    "terminal.ansiMagenta": "#7088FF",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#F8F9FA",
    "terminal.ansiBrightBlack": "#9AA5B9",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#38D9A9",
    "terminal.ansiBrightMagenta": "#7088FF",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#38D9A9",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#7088FF",
    "gitDecoration.ignoredResourceForeground": "#9AA5B973"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9AA5B9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords General",
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#52B788"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import & Export Keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#38D9A9"
      }
    },
    {
      "name": "Function Calls",
      "scope": [
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#38D9A9"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#7088FF"
      }
    },
    {
      "name": "Interfaces & Traits",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#7088FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.string.go"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#F8F9FA"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language Constants & Builtin Self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Fields",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#F8F9FA"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#F48C06"
      }
    },
    {
      "name": "String Escape Sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Booleans & Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant Identifiers",
      "scope": [
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#52B788"
      }
    },
    {
      "name": "HTML Component Tags",
      "scope": [
        "support.class.component",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#7088FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#38D9A9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "CSS Property Names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#38D9A9"
      }
    },
    {
      "name": "CSS Property Values & Constants",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#F48C06"
      }
    },
    {
      "name": "CSS Class & ID Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#7088FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS Pseudo-Classes & Pseudo-Elements",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Variables",
      "scope": [
        "variable.argument.css",
        "variable.css",
        "variable.scss"
      ],
      "settings": {
        "foreground": "#F8F9FA"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Builtin Functions",
      "scope": [
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust",
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Macros",
      "scope": [
        "support.macro.rust",
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#38D9A9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Rust Unsafe",
      "scope": [
        "keyword.other.unsafe.rust"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Go Builtin Functions & Packages",
      "scope": [
        "keyword.package.go",
        "keyword.import.go",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON & YAML Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#38D9A9"
      }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Prisma Models & Fields",
      "scope": [
        "entity.name.type.model.prisma"
      ],
      "settings": {
        "foreground": "#7088FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Docker Directives",
      "scope": [
        "keyword.other.dockerfile"
      ],
      "settings": {
        "foreground": "#52B788",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Shell Variables & Commands",
      "scope": [
        "variable.other.normal.shell",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#38D9A9",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7088FF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#F48C06"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "underline"
      }
    }
  ]
}