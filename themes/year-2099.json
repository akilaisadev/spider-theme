{
  "name": "Year 2099",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#00FFFFF2",
    "class.declaration": {
      "foreground": "#00FFFFF2",
      "fontStyle": "bold"
    },
    "type": "#00FFFFF2",
    "interface": {
      "foreground": "#00FFFFF2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#00FFFF",
    "method": "#00FFFF",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#E0E1E3E6",
    "property": "#E0E1E3D9",
    "keyword": "#FF003CB3",
    "string": "#FAED26",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#465362",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#00FFFF40",
    "foreground": "#E0E1E3E6",
    "widget.shadow": "#00000080",
    "editor.background": "#1E1032",
    "editor.foreground": "#E0E1E3",
    "editor.lineHighlightBackground": "#2B1747",
    "editor.selectionBackground": "#3D2466",
    "editor.inactiveSelectionBackground": "#3D246680",
    "editor.selectionHighlightBackground": "#3D2466A0",
    "editor.wordHighlightBackground": "#3D2466A0",
    "editor.wordHighlightStrongBackground": "#00FFFF30",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#00FFFF",
    "editorWhitespace.foreground": "#46536260",
    "editorIndentGuide.background": "#46536240",
    "editorIndentGuide.activeBackground": "#46536290",
    "editorBracketMatch.background": "#00FFFF40",
    "editorBracketMatch.border": "#00FFFFA0",
    "editorLineNumber.foreground": "#46536290",
    "editorLineNumber.activeForeground": "#E0E1E3",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#46536240",
    "sideBar.background": "#150A24",
    "sideBar.foreground": "#E0E1E3D9",
    "sideBar.border": "#150A24",
    "sideBarSectionHeader.background": "#150A24",
    "activityBar.background": "#0F071A",
    "activityBar.foreground": "#00FFFF",
    "activityBar.inactiveForeground": "#46536273",
    "activityBar.border": "#0F071A",
    "statusBar.background": "#0A0412",
    "statusBar.foreground": "#E0E1E3D9",
    "statusBar.border": "#0A0412",
    "statusBar.noFolderBackground": "#0A0412",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#150A24",
    "tab.activeBackground": "#1E1032",
    "tab.inactiveBackground": "#150A24",
    "panel.background": "#1E1032",
    "terminal.background": "#1E1032",
    "terminal.foreground": "#E0E1E3",
    "terminal.ansiBlack": "#0F071A",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#00FFFF",
    "terminal.ansiMagenta": "#00FFFF",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#E0E1E3",
    "terminal.ansiBrightBlack": "#465362",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#00FFFF",
    "terminal.ansiBrightMagenta": "#00FFFF",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#00FFFF",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#00FFFF",
    "gitDecoration.ignoredResourceForeground": "#46536273"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#465362",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FF003CB3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#00FFFFF2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#E0E1E3E6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#FAED26"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#00FFFFD9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#FF003CB3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}