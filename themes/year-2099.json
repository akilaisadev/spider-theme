{
  "name": "Year 2099",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#E056FD",
    "class.declaration": {
      "foreground": "#E056FD",
      "fontStyle": "bold"
    },
    "struct": "#E056FD",
    "enum": "#E5C07B",
    "enumMember": "#D19A66",
    "type": "#E056FD",
    "type.declaration": {
      "foreground": "#E056FD",
      "fontStyle": "bold"
    },
    "type.defaultLibrary": "#56B6C2",
    "typeParameter": {
      "foreground": "#E056FD",
      "fontStyle": "italic"
    },
    "interface": {
      "foreground": "#E056FD",
      "fontStyle": "italic"
    },
    "function": "#00FFFF",
    "function.declaration": {
      "foreground": "#00FFFF",
      "fontStyle": "bold"
    },
    "function.defaultLibrary": "#00FFFF",
    "method": "#00FFFF",
    "method.declaration": {
      "foreground": "#00FFFF",
      "fontStyle": "bold"
    },
    "macro": {
      "foreground": "#00FFFF",
      "fontStyle": "bold"
    },
    "parameter": {
      "foreground": "#56B6C2",
      "fontStyle": "italic"
    },
    "selfParameter": {
      "foreground": "#FF3366",
      "fontStyle": "italic"
    },
    "clsParameter": {
      "foreground": "#FF3366",
      "fontStyle": "italic"
    },
    "variable": "#E0E1E3",
    "variable.readonly": {
      "foreground": "#E5C07B",
      "fontStyle": "bold"
    },
    "variable.defaultLibrary": "#56B6C2",
    "property": "#E0E1E3",
    "property.readonly": "#E5C07B",
    "keyword": "#FF3366",
    "keyword.control": {
      "foreground": "#FF3366",
      "fontStyle": "bold"
    },
    "string": "#FAED26",
    "string.escape": {
      "foreground": "#FF3366",
      "fontStyle": "bold"
    },
    "number": "#D19A66",
    "operator": "#ABB2BFD9",
    "comment": {
      "foreground": "#8C9BB0",
      "fontStyle": "italic"
    },
    "decorator": {
      "foreground": "#C678DD",
      "fontStyle": "italic"
    },
    "namespace": "#56B6C2",
    "*.mutable": {
      "fontStyle": "underline"
    }
  },
  "colors": {
    "focusBorder": "#00FFFF40",
    "foreground": "#E0E1E3",
    "widget.shadow": "#00000080",
    "editor.background": "#1E1032",
    "editor.foreground": "#E0E1E3",
    "editor.lineHighlightBackground": "#2B1747",
    "editor.selectionBackground": "#3D2466",
    "editor.inactiveSelectionBackground": "#3D246680",
    "editor.selectionHighlightBackground": "#3D2466A0",
    "editor.wordHighlightBackground": "#3D2466A0",
    "editor.wordHighlightStrongBackground": "#00FFFF30",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#00FFFF",
    "editorWhitespace.foreground": "#8C9BB060",
    "editorIndentGuide.background": "#8C9BB040",
    "editorIndentGuide.activeBackground": "#8C9BB090",
    "editorBracketMatch.background": "#00FFFF40",
    "editorBracketMatch.border": "#00FFFFA0",
    "editorLineNumber.foreground": "#8C9BB090",
    "editorLineNumber.activeForeground": "#E0E1E3",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#8C9BB040",
    "sideBar.background": "#150A24",
    "sideBar.foreground": "#E0E1E3",
    "sideBar.border": "#150A24",
    "sideBarSectionHeader.background": "#150A24",
    "activityBar.background": "#0F071A",
    "activityBar.foreground": "#00FFFF",
    "activityBar.inactiveForeground": "#8C9BB073",
    "activityBar.border": "#0F071A",
    "statusBar.background": "#0A0412",
    "statusBar.foreground": "#E0E1E3",
    "statusBar.border": "#0A0412",
    "statusBar.noFolderBackground": "#0A0412",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#150A24",
    "tab.activeBackground": "#1E1032",
    "tab.inactiveBackground": "#150A24",
    "panel.background": "#1E1032",
    "terminal.background": "#1E1032",
    "terminal.foreground": "#E0E1E3",
    "terminal.ansiBlack": "#0F071A",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#00FFFF",
    "terminal.ansiMagenta": "#E056FD",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#E0E1E3",
    "terminal.ansiBrightBlack": "#8C9BB0",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#00FFFF",
    "terminal.ansiBrightMagenta": "#E056FD",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#00FFFF",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#E056FD",
    "gitDecoration.ignoredResourceForeground": "#8C9BB073"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8C9BB0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.arithmetic",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords General",
      "scope": [
        "keyword",
        "storage",
        "storage.type"
      ],
      "settings": {
        "foreground": "#FF3366"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.trycatch",
        "keyword.control.return"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Import & Export Keywords",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Functions & Methods",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function"
      ],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Function Calls",
      "scope": [
        "variable.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#00FFFF"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "entity.name.type.class",
        "entity.name.type.struct",
        "entity.name.type.enum"
      ],
      "settings": {
        "foreground": "#E056FD"
      }
    },
    {
      "name": "Interfaces & Traits",
      "scope": [
        "entity.name.type.interface",
        "entity.name.type.trait"
      ],
      "settings": {
        "foreground": "#E056FD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Primitive & Builtin Types",
      "scope": [
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.numeric.go",
        "storage.type.boolean.go",
        "storage.type.string.go"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other.readwrite",
        "variable.other.object"
      ],
      "settings": {
        "foreground": "#E0E1E3"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Language Constants & Builtin Self",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self",
        "variable.parameter.function.language.special.cls"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Object Properties & Fields",
      "scope": [
        "variable.other.property",
        "meta.object-literal.key",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#E0E1E3"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#FAED26"
      }
    },
    {
      "name": "String Escape Sequences",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Numbers & Units",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Booleans & Constants",
      "scope": [
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant Identifiers",
      "scope": [
        "variable.other.constant",
        "entity.name.constant"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & JSX Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.xml",
        "entity.name.tag.js",
        "entity.name.tag.jsx",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#FF3366"
      }
    },
    {
      "name": "HTML Component Tags",
      "scope": [
        "support.class.component",
        "entity.name.tag.custom"
      ],
      "settings": {
        "foreground": "#E056FD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "HTML & JSX Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.jsx",
        "entity.other.attribute-name.tsx"
      ],
      "settings": {
        "foreground": "#4CC9F0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "HTML Tag Punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "CSS Property Names",
      "scope": [
        "support.type.property-name.css",
        "support.type.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#4CC9F0"
      }
    },
    {
      "name": "CSS Property Values & Constants",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css",
        "support.constant.color"
      ],
      "settings": {
        "foreground": "#FAED26"
      }
    },
    {
      "name": "CSS Class & ID Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#E056FD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "CSS Pseudo-Classes & Pseudo-Elements",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS Variables",
      "scope": [
        "variable.argument.css",
        "variable.css",
        "variable.scss"
      ],
      "settings": {
        "foreground": "#E0E1E3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python Builtin Functions",
      "scope": [
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust",
        "storage.modifier.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Macros",
      "scope": [
        "support.macro.rust",
        "entity.name.function.macro.rust"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Rust Unsafe",
      "scope": [
        "keyword.other.unsafe.rust"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Go Builtin Functions & Packages",
      "scope": [
        "keyword.package.go",
        "keyword.import.go",
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSON & YAML Property Keys",
      "scope": [
        "support.type.property-name.json",
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4CC9F0"
      }
    },
    {
      "name": "SQL Keywords",
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Prisma Models & Fields",
      "scope": [
        "entity.name.type.model.prisma"
      ],
      "settings": {
        "foreground": "#E056FD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Docker Directives",
      "scope": [
        "keyword.other.dockerfile"
      ],
      "settings": {
        "foreground": "#FF3366",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Shell Variables & Commands",
      "scope": [
        "variable.other.normal.shell",
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#56B6C2"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#00FFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#E056FD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown Code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#FAED26"
      }
    },
    {
      "name": "Markdown Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "underline"
      }
    }
  ]
}