{
  "name": "The Syndicate",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#98C1D9F2",
    "class.declaration": {
      "foreground": "#98C1D9F2",
      "fontStyle": "bold"
    },
    "type": "#98C1D9F2",
    "interface": {
      "foreground": "#98C1D9F2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#E0FBFC",
    "method": "#E0FBFC",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#FFFFFFE6",
    "property": "#FFFFFFD9",
    "keyword": "#FFFFFFB3",
    "string": "#E5E5E5",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#3D5A80",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#E0FBFC40",
    "foreground": "#FFFFFFE6",
    "widget.shadow": "#00000080",
    "editor.background": "#17181A",
    "editor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#1C1D20",
    "editor.selectionBackground": "#2C2E33",
    "editor.inactiveSelectionBackground": "#2C2E3380",
    "editor.selectionHighlightBackground": "#2C2E33A0",
    "editor.wordHighlightBackground": "#2C2E33A0",
    "editor.wordHighlightStrongBackground": "#E0FBFC30",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#E0FBFC",
    "editorWhitespace.foreground": "#3D5A8060",
    "editorIndentGuide.background": "#3D5A8040",
    "editorIndentGuide.activeBackground": "#3D5A8090",
    "editorBracketMatch.background": "#E0FBFC40",
    "editorBracketMatch.border": "#E0FBFCA0",
    "editorLineNumber.foreground": "#3D5A8090",
    "editorLineNumber.activeForeground": "#FFFFFF",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#3D5A8040",
    "sideBar.background": "#101112",
    "sideBar.foreground": "#FFFFFFD9",
    "sideBar.border": "#101112",
    "sideBarSectionHeader.background": "#101112",
    "activityBar.background": "#0B0B0C",
    "activityBar.foreground": "#E0FBFC",
    "activityBar.inactiveForeground": "#3D5A8073",
    "activityBar.border": "#0B0B0C",
    "statusBar.background": "#050506",
    "statusBar.foreground": "#FFFFFFD9",
    "statusBar.border": "#050506",
    "statusBar.noFolderBackground": "#050506",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#101112",
    "tab.activeBackground": "#17181A",
    "tab.inactiveBackground": "#101112",
    "panel.background": "#17181A",
    "terminal.background": "#17181A",
    "terminal.foreground": "#FFFFFF",
    "terminal.ansiBlack": "#0B0B0C",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#E0FBFC",
    "terminal.ansiMagenta": "#98C1D9",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#FFFFFF",
    "terminal.ansiBrightBlack": "#3D5A80",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#E0FBFC",
    "terminal.ansiBrightMagenta": "#98C1D9",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#E0FBFC",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#98C1D9",
    "gitDecoration.ignoredResourceForeground": "#3D5A8073"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#3D5A80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FFFFFFB3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#E0FBFC"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#98C1D9F2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FFFFFFE6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#E5E5E5"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#E0FBFC",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#98C1D9D9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#FFFFFFB3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}