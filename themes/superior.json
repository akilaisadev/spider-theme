{
  "name": "Superior",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#0A9396",
    "class.declaration": {
      "foreground": "#0A9396",
      "fontStyle": "bold"
    },
    "type": "#0A9396",
    "interface": {
      "foreground": "#0A9396",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#C0C0C0",
    "method": "#C0C0C0",
    "parameter": {
      "foreground": "#56B6C2",
      "fontStyle": "italic"
    },
    "variable": "#FDFCDC",
    "property": "#FDFCDC",
    "keyword": "#FF4D5D",
    "string": "#EE9B00",
    "number": "#D19A66",
    "operator": "#ABB2BFD9",
    "comment": {
      "foreground": "#979DAC",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#C0C0C040",
    "foreground": "#FDFCDC",
    "widget.shadow": "#00000080",
    "editor.background": "#0F1423",
    "editor.foreground": "#FDFCDC",
    "editor.lineHighlightBackground": "#161D33",
    "editor.selectionBackground": "#212A45",
    "editor.inactiveSelectionBackground": "#212A4580",
    "editor.selectionHighlightBackground": "#212A45A0",
    "editor.wordHighlightBackground": "#212A45A0",
    "editor.wordHighlightStrongBackground": "#C0C0C030",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#C0C0C0",
    "editorWhitespace.foreground": "#979DAC60",
    "editorIndentGuide.background": "#979DAC40",
    "editorIndentGuide.activeBackground": "#979DAC90",
    "editorBracketMatch.background": "#C0C0C040",
    "editorBracketMatch.border": "#C0C0C0A0",
    "editorLineNumber.foreground": "#979DAC90",
    "editorLineNumber.activeForeground": "#FDFCDC",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#979DAC40",
    "sideBar.background": "#0A0D17",
    "sideBar.foreground": "#FDFCDC",
    "sideBar.border": "#0A0D17",
    "sideBarSectionHeader.background": "#0A0D17",
    "activityBar.background": "#070A12",
    "activityBar.foreground": "#C0C0C0",
    "activityBar.inactiveForeground": "#979DAC73",
    "activityBar.border": "#070A12",
    "statusBar.background": "#05070D",
    "statusBar.foreground": "#FDFCDC",
    "statusBar.border": "#05070D",
    "statusBar.noFolderBackground": "#05070D",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#0A0D17",
    "tab.activeBackground": "#0F1423",
    "tab.inactiveBackground": "#0A0D17",
    "panel.background": "#0F1423",
    "terminal.background": "#0F1423",
    "terminal.foreground": "#FDFCDC",
    "terminal.ansiBlack": "#070A12",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#C0C0C0",
    "terminal.ansiMagenta": "#0A9396",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#FDFCDC",
    "terminal.ansiBrightBlack": "#979DAC",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#C0C0C0",
    "terminal.ansiBrightMagenta": "#0A9396",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#C0C0C0",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#0A9396",
    "gitDecoration.ignoredResourceForeground": "#979DAC73"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#979DAC",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#FF4D5D"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#C0C0C0"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#0A9396"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FDFCDC"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#EE9B00"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#C0C0C0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#0A9396",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#FF4D5D"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}