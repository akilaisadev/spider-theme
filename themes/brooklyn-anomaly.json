{
  "name": "Brooklyn Anomaly",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#B5179EF2",
    "class.declaration": {
      "foreground": "#B5179EF2",
      "fontStyle": "bold"
    },
    "type": "#B5179EF2",
    "interface": {
      "foreground": "#B5179EF2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#4CC9F0",
    "method": "#4CC9F0",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#FFFFFFE6",
    "property": "#FFFFFFD9",
    "keyword": "#F72585B3",
    "string": "#FEE440",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#6C757D",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#4CC9F040",
    "foreground": "#FFFFFFE6",
    "widget.shadow": "#00000080",
    "editor.background": "#000000",
    "editor.foreground": "#FFFFFF",
    "editor.lineHighlightBackground": "#0F0F0F",
    "editor.selectionBackground": "#1A1A1A",
    "editor.inactiveSelectionBackground": "#1A1A1A80",
    "editor.selectionHighlightBackground": "#1A1A1AA0",
    "editor.wordHighlightBackground": "#1A1A1AA0",
    "editor.wordHighlightStrongBackground": "#4CC9F030",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#4CC9F0",
    "editorWhitespace.foreground": "#6C757D60",
    "editorIndentGuide.background": "#6C757D40",
    "editorIndentGuide.activeBackground": "#6C757D90",
    "editorBracketMatch.background": "#4CC9F040",
    "editorBracketMatch.border": "#4CC9F0A0",
    "editorLineNumber.foreground": "#6C757D90",
    "editorLineNumber.activeForeground": "#FFFFFF",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#6C757D40",
    "sideBar.background": "#050505",
    "sideBar.foreground": "#FFFFFFD9",
    "sideBar.border": "#050505",
    "sideBarSectionHeader.background": "#050505",
    "activityBar.background": "#080808",
    "activityBar.foreground": "#4CC9F0",
    "activityBar.inactiveForeground": "#6C757D73",
    "activityBar.border": "#080808",
    "statusBar.background": "#0A0A0A",
    "statusBar.foreground": "#FFFFFFD9",
    "statusBar.border": "#0A0A0A",
    "statusBar.noFolderBackground": "#0A0A0A",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#050505",
    "tab.activeBackground": "#000000",
    "tab.inactiveBackground": "#050505",
    "panel.background": "#000000",
    "terminal.background": "#000000",
    "terminal.foreground": "#FFFFFF",
    "terminal.ansiBlack": "#080808",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#4CC9F0",
    "terminal.ansiMagenta": "#B5179E",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#FFFFFF",
    "terminal.ansiBrightBlack": "#6C757D",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#4CC9F0",
    "terminal.ansiBrightMagenta": "#B5179E",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#4CC9F0",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#B5179E",
    "gitDecoration.ignoredResourceForeground": "#6C757D73"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6C757D",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#F72585B3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#4CC9F0"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#B5179EF2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#FFFFFFE6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#FEE440"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#4CC9F0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#B5179ED9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#F72585B3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}