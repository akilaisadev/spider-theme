{
  "name": "Absolute Carnage",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "#9D0208F2",
    "class.declaration": {
      "foreground": "#9D0208F2",
      "fontStyle": "bold"
    },
    "type": "#9D0208F2",
    "interface": {
      "foreground": "#9D0208F2",
      "fontStyle": "italic"
    },
    "enum": "#E5C07B",
    "function": "#FFFFFF",
    "method": "#FFFFFF",
    "parameter": {
      "foreground": "#56B6C2D9",
      "fontStyle": "italic"
    },
    "variable": "#CED4DAE6",
    "property": "#CED4DAD9",
    "keyword": "#D00000B3",
    "string": "#E85D04",
    "number": "#D19A66",
    "operator": "#ABB2BF8C",
    "comment": {
      "foreground": "#6C5B7B",
      "fontStyle": "italic"
    },
    "decorator": "#C678DD",
    "namespace": "#56B6C2",
    "*.mutable": "#D19A66"
  },
  "colors": {
    "focusBorder": "#FFFFFF40",
    "foreground": "#CED4DAE6",
    "widget.shadow": "#00000080",
    "editor.background": "#111217",
    "editor.foreground": "#CED4DA",
    "editor.lineHighlightBackground": "#16181F",
    "editor.selectionBackground": "#20222B",
    "editor.inactiveSelectionBackground": "#20222B80",
    "editor.selectionHighlightBackground": "#20222BA0",
    "editor.wordHighlightBackground": "#20222BA0",
    "editor.wordHighlightStrongBackground": "#FFFFFF30",
    "editor.findMatchBackground": "#E5C07B80",
    "editor.findMatchHighlightBackground": "#E5C07B30",
    "editor.findRangeHighlightBackground": "#E5C07B1A",
    "editorCursor.foreground": "#FFFFFF",
    "editorWhitespace.foreground": "#6C5B7B60",
    "editorIndentGuide.background": "#6C5B7B40",
    "editorIndentGuide.activeBackground": "#6C5B7B90",
    "editorBracketMatch.background": "#FFFFFF40",
    "editorBracketMatch.border": "#FFFFFFA0",
    "editorLineNumber.foreground": "#6C5B7B90",
    "editorLineNumber.activeForeground": "#CED4DA",
    "diffEditor.insertedTextBackground": "#98C3791A",
    "diffEditor.removedTextBackground": "#E06C751A",
    "diffEditor.insertedLineBackground": "#98C37910",
    "diffEditor.removedLineBackground": "#E06C7510",
    "diffEditor.diagonalFill": "#6C5B7B40",
    "sideBar.background": "#0E0E12",
    "sideBar.foreground": "#CED4DAD9",
    "sideBar.border": "#0E0E12",
    "sideBarSectionHeader.background": "#0E0E12",
    "activityBar.background": "#0A0B0E",
    "activityBar.foreground": "#FFFFFF",
    "activityBar.inactiveForeground": "#6C5B7B73",
    "activityBar.border": "#0A0B0E",
    "statusBar.background": "#08090C",
    "statusBar.foreground": "#CED4DAD9",
    "statusBar.border": "#08090C",
    "statusBar.noFolderBackground": "#08090C",
    "statusBar.debuggingBackground": "#E5C07B40",
    "editorGroupHeader.tabsBackground": "#0E0E12",
    "tab.activeBackground": "#111217",
    "tab.inactiveBackground": "#0E0E12",
    "panel.background": "#111217",
    "terminal.background": "#111217",
    "terminal.foreground": "#CED4DA",
    "terminal.ansiBlack": "#0A0B0E",
    "terminal.ansiRed": "#E06C75",
    "terminal.ansiGreen": "#98C379",
    "terminal.ansiYellow": "#E5C07B",
    "terminal.ansiBlue": "#FFFFFF",
    "terminal.ansiMagenta": "#9D0208",
    "terminal.ansiCyan": "#56B6C2",
    "terminal.ansiWhite": "#CED4DA",
    "terminal.ansiBrightBlack": "#6C5B7B",
    "terminal.ansiBrightRed": "#E06C75",
    "terminal.ansiBrightGreen": "#98C379",
    "terminal.ansiBrightYellow": "#E5C07B",
    "terminal.ansiBrightBlue": "#FFFFFF",
    "terminal.ansiBrightMagenta": "#9D0208",
    "terminal.ansiBrightCyan": "#56B6C2",
    "terminal.ansiBrightWhite": "#FFFFFF",
    "gitDecoration.addedResourceForeground": "#98C379",
    "gitDecoration.modifiedResourceForeground": "#FFFFFF",
    "gitDecoration.deletedResourceForeground": "#E06C75",
    "gitDecoration.untrackedResourceForeground": "#56B6C2",
    "gitDecoration.conflictingResourceForeground": "#9D0208",
    "gitDecoration.ignoredResourceForeground": "#6C5B7B73"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6C5B7B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Comment TODO",
      "scope": [
        "comment.keyword.todo",
        "comment.line.todo"
      ],
      "settings": {
        "foreground": "#D19A66",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment FIXME",
      "scope": [
        "comment.keyword.fixme",
        "comment.line.fixme"
      ],
      "settings": {
        "foreground": "#E06C75",
        "fontStyle": "bold underline"
      }
    },
    {
      "name": "Comment NOTE",
      "scope": [
        "comment.keyword.note",
        "comment.line.note"
      ],
      "settings": {
        "foreground": "#61AFEF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment WARNING",
      "scope": [
        "comment.keyword.warning",
        "comment.line.warning"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Comment HACK",
      "scope": [
        "comment.keyword.hack",
        "comment.line.hack"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Punctuation & Noise",
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#ABB2BFD9"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage",
        "variable.language"
      ],
      "settings": {
        "foreground": "#D00000B3"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#FFFFFF"
      }
    },
    {
      "name": "Classes/Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class"
      ],
      "settings": {
        "foreground": "#9D0208F2"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable"
      ],
      "settings": {
        "foreground": "#CED4DAE6"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string"
      ],
      "settings": {
        "foreground": "#E85D04"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#D19A66"
      }
    },
    {
      "name": "Markdown Headers",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#FFFFFF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown Blockquote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#9D0208D9",
        "fontStyle": "italic"
      }
    },
    {
      "name": "React JSX Tags",
      "scope": [
        "entity.name.tag.js",
        "entity.name.tag.tsx"
      ],
      "settings": {
        "foreground": "#D00000B3"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.function.decorator.python"
      ],
      "settings": {
        "foreground": "#C678DD",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Lifetimes",
      "scope": [
        "entity.name.type.lifetime.rust"
      ],
      "settings": {
        "foreground": "#E5C07B",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Kotlin Extension Functions",
      "scope": [
        "entity.name.function.extension.kotlin"
      ],
      "settings": {
        "foreground": "#56B6C2",
        "fontStyle": "bold"
      }
    }
  ]
}